# Flask / App
SECRET_KEY=supersecret123
PORT=8000
RAG_API_PORT=8000
FLASK_DEBUG=false
CORS_ORIGINS=http://localhost:5173

# Cloud PostgreSQL (Add your credentials)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@switchyard.proxy.rlwy.net:12684/railway
# MongoDB Atlas (Add your credentials)
MONGO_URI=mongodb+srv://YOUR_MONGO_USER:YOUR_MONGO_PASSWORD@cluster1.dreipab.mongodb.net/?appName=Cluster1
MONGO_DB_NAME=pathshala

# Chroma (RAG vector database)
CHROMA_PERSIST_DIR=backend/chroma/data
CHROMA_COLLECTION_NAME=ncert_class10_science
CHROMA_COLLECTION_CLASS_6=ncert_class6_science
CHROMA_COLLECTION_CLASS_10=ncert_class10_science
DEFAULT_CLASS_LEVEL=10
CHROMA_USE_CLASS_FILTER=true

# Hugging Face Inference API (Add your API key)
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HF_API_KEY=YOUR_HUGGINGFACE_API_KEY
